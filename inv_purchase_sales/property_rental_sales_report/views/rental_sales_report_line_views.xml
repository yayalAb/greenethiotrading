<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List / Tree view for Rental Summary of Sales -->
    <record id="view_rental_sales_report_line_tree" model="ir.ui.view">
        <field name="name">rental.sales.report.line.list</field>
        <field name="model">rental.sales.report.line</field>
        <field name="arch" type="xml">
            <list string="Rental Summary of Sales" create="0" delete="0" edit="0">
                <header>
                    <button name="action_export_excel" string="Export Excel (.xlsx)" type="object" class="btn-primary" icon="fa-file-excel-o"/>
                    <button name="action_export_pdf" string="Export PDF" type="object" class="btn-secondary" icon="fa-file-pdf-o"/>
                    <button name="%(property_rental_sales_report.action_property_rental_sales_report_wizard)d" string="Change Fiscal Year / Filter" type="action" class="btn-secondary" icon="fa-filter"/>
                </header>
                <field name="sn" string="S/N" optional="show"/>
                <field name="shop_code" string="Shop Code" optional="show"/>
                <field name="customer_name" string="Customer Name" optional="hide"/>
                <field name="remark_cust" string="Remark" optional="hide"/>
                <field name="location" string="Location" optional="hide"/>
                <field name="floor" string="Floor" optional="show"/>
                <field name="start_date" string="Rent Start" optional="hide"/>
                <field name="end_date" string="Rent End" optional="hide"/>
                <field name="total_area" string="Total Area" sum="Total Area" optional="show"/>
                <field name="price_per_sqm" string="Price /Sqm (No VAT)" optional="show"/>
                <field name="monthly_before_vat" string="Monthly (No VAT)" sum="Monthly (No VAT)" optional="show"/>
                <field name="monthly_with_vat" string="Monthly (With VAT)" sum="Monthly (With VAT)" optional="show"/>
                <!-- 12 Ethiopian Months: Hamle, Nehase, Meskerem shown by default, remaining hidden by default -->
                <field name="m_0" string="Hamle" sum="Hamle" optional="show"/>
                <field name="m_1" string="Nehase" sum="Nehase" optional="show"/>
                <field name="m_2" string="Meskerem" sum="Meskerem" optional="show"/>
                <field name="m_3" string="Tikimt" sum="Tikimt" optional="hide"/>
                <field name="m_4" string="Hidar" sum="Hidar" optional="hide"/>
                <field name="m_5" string="Tahsas" sum="Tahsas" optional="hide"/>
                <field name="m_6" string="Tir" sum="Tir" optional="hide"/>
                <field name="m_7" string="Yekatit" sum="Yekatit" optional="hide"/>
                <field name="m_8" string="Megabit" sum="Megabit" optional="hide"/>
                <field name="m_9" string="Miazia" sum="Miazia" optional="hide"/>
                <field name="m_10" string="Ginbot" sum="Ginbot" optional="hide"/>
                <field name="m_11" string="Sene" sum="Sene" optional="hide"/>
                <field name="total" string="TOTAL" sum="Grand Total" optional="show"/>
                <field name="remark" string="Status" optional="show"/>
                <field name="fiscal_year" string="Fiscal Year" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Search View with Rich Filters and Group By -->
    <record id="view_rental_sales_report_line_search" model="ir.ui.view">
        <field name="name">rental.sales.report.line.search</field>
        <field name="model">rental.sales.report.line</field>
        <field name="arch" type="xml">
            <search string="Search Rental Sales Report">
                <field name="shop_code" string="Shop Code"/>
                <field name="customer_name" string="Customer / Renter"/>
                <field name="location" string="Location / Building"/>
                <field name="floor" string="Floor"/>
                <field name="fiscal_year" string="Fiscal Year"/>

                <separator/>
                <filter string="Active Rentals" name="filter_active" domain="[('remark', '=', 'Active')]"/>
                <filter string="Unrented Properties" name="filter_unrented" domain="['|', ('remark_cust', '=', 'Unrented'), ('remark', '=', 'Unrented')]"/>
                <filter string="With Invoiced Revenue" name="filter_has_revenue" domain="[('total', '>', 0)]"/>

                <group expand="0" string="Group By">
                    <filter string="Location" name="group_location" context="{'group_by': 'location'}"/>
                    <filter string="Floor" name="group_floor" context="{'group_by': 'floor'}"/>
                    <filter string="Status" name="group_remark" context="{'group_by': 'remark'}"/>
                    <filter string="Fiscal Year" name="group_fy" context="{'group_by': 'fiscal_year'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action Action for Direct List View (Direct Menu Target) -->
    <record id="action_rental_sales_report_line_view" model="ir.actions.server">
        <field name="name">Rental Summary of Sales</field>
        <field name="model_id" ref="property_rental_sales_report.model_rental_sales_report_line"/>
        <field name="state">code</field>
        <field name="code">action = model.action_refresh_data()</field>
    </record>

    <!-- Menu Item directly triggers the List View via Server Action -->
    <menuitem id="menu_property_rental_sales_report_list"
              name="Rental Summary"
              parent="property_management.property_report_menu"
              action="action_rental_sales_report_line_view"
              sequence="20"/>

    <!-- Action menu bindings for selected records export -->
    <record id="action_export_excel_server" model="ir.actions.server">
        <field name="name">Export to Excel (.xlsx)</field>
        <field name="model_id" ref="property_rental_sales_report.model_rental_sales_report_line"/>
        <field name="binding_model_id" ref="property_rental_sales_report.model_rental_sales_report_line"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_export_excel()</field>
    </record>

    <record id="action_export_pdf_server" model="ir.actions.server">
        <field name="name">Export to PDF</field>
        <field name="model_id" ref="property_rental_sales_report.model_rental_sales_report_line"/>
        <field name="binding_model_id" ref="property_rental_sales_report.model_rental_sales_report_line"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_export_pdf()</field>
    </record>
</odoo>
