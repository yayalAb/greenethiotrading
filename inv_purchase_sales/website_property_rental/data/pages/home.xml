<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">
    <record id="website.homepage" model="ir.ui.view">
        <field name="active" eval="False"/>
    </record>

    <record id="page_home" model="website.page">
        <field name="name">Home</field>
        <field name="is_published" eval="True"/>
        <field name="key">website_property_rental.page_home</field>
        <field name="url">/</field>
        <field name="type">qweb</field>
        <field name="website_indexed" eval="True"/>
        <field name="website_meta_title">Building Rent | Temesgen Kefyalew Building Rent</field>
        <field name="website_meta_description">Offices, shops, and homes for rent in Temesgen Kefyalew Building, Addis Ababa.</field>
        <field name="arch" type="xml">
            <t t-name="website_property_rental.page_home">
                <t t-call="website.layout">
                    <t t-set="additional_title">Building Rent | Temesgen Kefyalew Building Rent</t>
                    <div id="wrap" class="oe_structure kad-site">
                        <t t-call="website_property_rental.homepage_body"/>
                    </div>
                </t>
            </t>
        </field>
    </record>
</odoo>
