<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_property_rental_request" model="ir.sequence">
        <field name="name">Rental Enquiry</field>
        <field name="code">property.rental.request</field>
        <field name="prefix">REQ/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <data noupdate="0">
        <record id="menu_get_for_rent" model="website.menu">
            <field name="name">For Rent</field>
            <field name="url">/#for-rent</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence">20</field>
        </record>
        <record id="menu_get_for_sale" model="website.menu">
            <field name="name">For Sale</field>
            <field name="url">/#for-sale</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence">25</field>
        </record>
        <record id="menu_get_services" model="website.menu">
            <field name="name">Services</field>
            <field name="url">/#services</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence">30</field>
        </record>
        <record id="menu_get_about" model="website.menu">
            <field name="name">About Us</field>
            <field name="url">/#about</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence">40</field>
        </record>
        <record id="menu_get_why" model="website.menu">
            <field name="name">Why Us</field>
            <field name="url">/#why-us</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence">70</field>
        </record>
        <record id="menu_get_enquire" model="website.menu">
            <field name="name">Enquire</field>
            <field name="url">/#enquire</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence">85</field>
        </record>
        <record id="menu_get_contact" model="website.menu">
            <field name="name">Contact</field>
            <field name="url">/#contact</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence">95</field>
        </record>
        <function model="website" name="_get_sync_menus"/>
    </data>
</odoo>
