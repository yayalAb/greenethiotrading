<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="property_rental_request_view_list" model="ir.ui.view">
        <field name="name">property.rental.request.list</field>
        <field name="model">property.rental.request</field>
        <field name="arch" type="xml">
            <list string="Rental Enquiries" decoration-info="state == 'new'" decoration-success="state == 'won'">
                <field name="name"/>
                <field name="property_id"/>
                <field name="partner_name"/>
                <field name="partner_email"/>
                <field name="partner_phone"/>
                <field name="start_date"/>
                <field name="rent_month"/>
                <field name="state" widget="badge" decoration-info="state == 'new'" decoration-warning="state == 'in_progress'" decoration-success="state == 'won'" decoration-danger="state == 'lost'"/>
                <field name="user_id" widget="many2one_avatar_user"/>
            </list>
        </field>
    </record>

    <record id="property_rental_request_view_form" model="ir.ui.view">
        <field name="name">property.rental.request.form</field>
        <field name="model">property.rental.request</field>
        <field name="arch" type="xml">
            <form string="Rental Enquiry">
                <header>
                    <button name="action_in_progress" type="object" string="Mark In Progress" class="btn-primary" invisible="state != 'new'"/>
                    <button name="action_won" type="object" string="Converted" class="btn-success" invisible="state in ('won', 'lost')"/>
                    <button name="action_lost" type="object" string="Decline" invisible="state in ('won', 'lost')"/>
                    <button name="action_open_property" type="object" string="Open Property" class="btn-secondary"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,in_progress,won"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="property_id"/>
                            <field name="rent_month"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="user_id"/>
                        </group>
                        <group>
                            <field name="partner_name"/>
                            <field name="partner_email" widget="email"/>
                            <field name="partner_phone" widget="phone"/>
                            <field name="start_date"/>
                            <field name="duration_months"/>
                        </group>
                    </group>
                    <group>
                        <field name="message" placeholder="Visitor message..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="property_rental_request_view_search" model="ir.ui.view">
        <field name="name">property.rental.request.search</field>
        <field name="model">property.rental.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_name"/>
                <field name="partner_email"/>
                <field name="property_id"/>
                <filter name="new" string="New" domain="[('state', '=', 'new')]"/>
                <filter name="mine" string="My Enquiries" domain="[('user_id', '=', uid)]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_property" string="Property" context="{'group_by': 'property_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_property_rental_request" model="ir.actions.act_window">
        <field name="name">Website Enquiries</field>
        <field name="res_model">property.rental.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_new': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No rental enquiries yet</p>
            <p>Website visitors submit requests from the Rentals pages.</p>
        </field>
    </record>

    <menuitem id="property_rental_request_menu"
              name="Website Enquiries"
              parent="advanced_property_management.property_menu"
              action="action_property_rental_request"
              sequence="21"/>
</odoo>
