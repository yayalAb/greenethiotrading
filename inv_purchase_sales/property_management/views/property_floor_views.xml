<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Property floor action -->
    <record id="property_floor_action" model="ir.actions.act_window">
        <field name="name">Floors</field>
        <field name="res_model">property.floor</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create Your First Floor!
            </p>
        </field>
    </record>

    <!-- Property floor menu item -->
    <menuitem id="property_floor_menu" name="Floors"
              parent="property_configuration_menu"
              action="property_floor_action" sequence="5"/>

    <!-- Property floor list view -->
    <record id="property_floor_view_list" model="ir.ui.view">
        <field name="name">property.floor.view.list</field>
        <field name="model">property.floor</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="floor_no"/>
                <field name="property_count" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Property floor form view -->
    <record id="property_floor_view_form" model="ir.ui.view">
        <field name="name">property.floor.view.form</field>
        <field name="model">property.floor</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_properties" type="object"
                                class="oe_stat_button" icon="fa-building-o">
                            <field name="property_count" widget="statinfo" string="Properties"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Floor Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Ground Floor, 1st Floor"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" placeholder="e.g. GF, 1F, 2F"/>
                            <field name="floor_no"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Property floor search view -->
    <record id="property_floor_view_search" model="ir.ui.view">
        <field name="name">property.floor.view.search</field>
        <field name="model">property.floor</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Floor"/>
                <field name="code"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>
</odoo>
