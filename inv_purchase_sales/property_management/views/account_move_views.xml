<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Inherit the standard invoice form to show rental period dates
         when the invoice is linked to a property rental -->
    <record id="account_move_form_rental_period" model="ir.ui.view">
        <field name="name">account.move.form.rental.period</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Insert Rental Period group just below the main partner/date group -->
            <xpath expr="//field[@name='invoice_line_ids']" position="before">
                <group string="Rental Period"
                       invisible="property_rental_id == False">
                    <group>
                        <field name="rental_invoice_start_date"/>
                    </group>
                    <group>
                        <field name="rental_invoice_end_date"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
