<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--
        Inherit from stock_picking_custom's account.move view
        (which already removes the broken refresh_invoice_currency_rate button)
        to add Rental Period fields on the invoice form.
        Visible only when the invoice is linked to a property rental.
    -->
    <record id="account_move_form_rental_period" model="ir.ui.view">
        <field name="name">account.move.form.rental.period</field>
        <field name="model">account.move</field>
        <field name="inherit_id"
               ref="stock_picking_custom.view_move_form_fs_mrc_payment"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']" position="before">
                <group string="Rental Period"
                       invisible="property_rental_id == False">
                    <group>
                        <field name="property_rental_id" readonly="1"/>
                        <field name="rental_invoice_start_date"/>
                    </group>
                    <group>
                        <field name="rental_invoice_end_date"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
