<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Property penalty action -->
    <record id="property_penalty_action" model="ir.actions.act_window">
        <field name="name">Penalties</field>
        <field name="res_model">property.penalty</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Rental Penalty Rule!
            </p>
            <p>
                Configure late payment penalties with grace/tolerance days and fixed or percentage amounts.
            </p>
        </field>
    </record>

    <!-- Property penalty menu item -->
    <menuitem id="property_penalty_menu" name="Penalties"
              parent="property_configuration_menu"
              action="property_penalty_action" sequence="6"/>

    <!-- Property penalty list view -->
    <record id="property_penalty_view_list" model="ir.ui.view">
        <field name="name">property.penalty.view.list</field>
        <field name="model">property.penalty</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="tolerance_days"/>
                <field name="amount_type"/>
                <field name="amount"/>
                <field name="description"/>
                <field name="active" widget="boolean_toggle" optional="show"/>
            </list>
        </field>
    </record>

    <!-- Property penalty form view -->
    <record id="property_penalty_view_form" model="ir.ui.view">
        <field name="name">property.penalty.view.form</field>
        <field name="model">property.penalty</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name" string="Penalty Rule Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Overdue 5% (Grace 3 Days)"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="tolerance_days"/>
                            <field name="amount_type"/>
                            <label for="amount"/>
                            <div class="o_row">
                                <field name="amount"/>
                                <span invisible="amount_type != 'percentage'">%</span>
                                <field name="currency_id" invisible="amount_type != 'fixed'" options="{'no_open': True}"/>
                            </div>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" placeholder="Specify any additional terms or conditions for this penalty..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Property penalty search view -->
    <record id="property_penalty_view_search" model="ir.ui.view">
        <field name="name">property.penalty.view.search</field>
        <field name="model">property.penalty</field>
        <field name="arch" type="xml">
            <search string="Search Penalties">
                <field name="name"/>
                <field name="amount_type"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Amount Type" name="group_amount_type" context="{'group_by': 'amount_type'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
