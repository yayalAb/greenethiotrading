<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="loyal_property_dashboard.KpiCard" owl="1">
        <div class="col-lg-2 col-md-4 col-sm-12 m-0 p-0">
            <div class="shadow-sm border m-2 p-4 text-center"
                 t-att-style="'background-color: ' + props.bgColor + '; cursor: pointer; height: 200px; border-radius: 5px;'"
                 t-on-click="onCardClick">
                <div class="h3 fw-bold text-dark" t-esc="props.name"/>
                <div class="h1 text-muted"><span t-esc="props.value"/></div>
                <div class="h3 mt-5">
                    <span class="text-success">
                        <span t-attf-class="fa #{props.iconClass} me-1"/>
                        <span t-esc="displayPercentage"/>%
                    </span>
                </div>
            </div>
        </div>
    </t>
</templates>
