<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">
    <record id="website.homepage" model="ir.ui.view">
        <field name="active" eval="False"/>
    </record>

    <record id="page_home" model="website.page">
        <field name="name">Home</field>
        <field name="is_published" eval="True"/>
        <field name="key">website_greenethio.page_home</field>
        <field name="url">/</field>
        <field name="type">qweb</field>
        <field name="website_indexed" eval="True"/>
        <field name="website_meta_title">Green Ethio Trading P.L.C. | Import &amp; Export</field>
        <field name="website_meta_description">Greenethiotrading PLC exports Ethiopian coffee, soybean, sesame, and oil seeds, and imports construction machinery, heavy trucks, cars, and metal.</field>
        <field name="arch" type="xml">
            <t t-name="website_greenethio.page_home">
                <t t-call="website.layout">
                    <t t-set="additional_title">Green Ethio Trading P.L.C. | Import &amp; Export</t>
                    <div id="wrap" class="oe_structure get-site">
                        <t t-call="website_greenethio.homepage_body"/>
                    </div>
                </t>
            </t>
        </field>
    </record>
</odoo>
