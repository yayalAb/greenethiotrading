<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="contact_thanks" name="GET Contact Thank You">
        <t t-call="website.layout">
            <t t-set="additional_title">Thank You | Green Ethio Trading</t>
            <div id="wrap" class="oe_structure get-site">
                <section class="get-section">
                    <div class="container text-center" style="max-width: 640px;">
                        <img src="/website_greenethio/static/src/img/logo.png"
                             alt="Green Ethio Trading"
                             class="get-hero__logo mx-auto mb-4"
                             style="width: 140px;"/>
                        <p class="get-kicker">Message received</p>
                        <h1 class="mb-3">Thank you for contacting Green Ethio Trading</h1>
                        <p class="mb-4" style="color: var(--get-muted);">
                            Our team will get back to you shortly about your import, export,
                            or partnership inquiry.
                        </p>
                        <a href="/" class="get-btn get-btn--primary">Back to Home</a>
                    </div>
                </section>
            </div>
        </t>
    </template>
</odoo>
