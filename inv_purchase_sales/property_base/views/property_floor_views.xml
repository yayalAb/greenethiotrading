<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Property floor action -->
    <record id="property_floor_action" model="ir.actions.act_window">
        <field name="name">Floors</field>
        <field name="res_model">property.floor</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create Your First Floor!
            </p>
        </field>
    </record>

    <!-- Property floor list view inherit -->
    <record id="property_floor_view_list_inherit_base" model="ir.ui.view">
        <field name="name">property.floor.view.list.inherit.base</field>
        <field name="model">property.floor</field>
        <field name="inherit_id" ref="property_management.property_floor_view_list"/>
        <field name="arch" type="xml">
            <field name="floor_no" position="after">
                <field name="building_id"/>
                <field name="site_id"/>
            </field>
        </field>
    </record>

    <!-- Property floor form view inherit -->
    <record id="property_floor_view_form_inherit_base" model="ir.ui.view">
        <field name="name">property.floor.view.form.inherit.base</field>
        <field name="model">property.floor</field>
        <field name="inherit_id" ref="property_management.property_floor_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[1]" position="inside">
                <group string="Building / Site">
                    <field name="building_id"/>
                    <field name="site_id" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Property floor search view inherit -->
    <record id="property_floor_view_search_inherit_base" model="ir.ui.view">
        <field name="name">property.floor.view.search.inherit.base</field>
        <field name="model">property.floor</field>
        <field name="inherit_id" ref="property_management.property_floor_view_search"/>
        <field name="arch" type="xml">
            <field name="code" position="after">
                <field name="building_id"/>
                <field name="site_id"/>
            </field>
            <filter name="inactive" position="after">
                <group expand="1" string="Group By">
                    <filter string="Building" context="{'group_by': 'building_id'}"
                            name="building_id"/>
                    <filter string="Site" context="{'group_by': 'site_id'}"
                            name="site_id"/>
                </group>
            </filter>
        </field>
    </record>
</odoo>
