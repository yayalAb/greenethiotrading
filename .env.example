# PostgreSQL (must match db_user / db_password in etc/odoo.conf)
POSTGRES_USER=odoo
POSTGRES_PASSWORD=change-me-strong-password

# Public hostnames and Let's Encrypt (one certificate covers all names)
SSL_DOMAIN=temesgenkefyalew.com
SSL_EXTRA_DOMAINS=www.temesgenkefyalew.com,greenethiotrading.com,www.greenethiotrading.com
CERTBOT_EMAIL=admin@temesgenkefyalew.com

# Optional certbot timing (seconds)
# CERTBOT_RETRY_SECONDS=300
# CERTBOT_RENEW_INTERVAL=43200
